# Copy to .env and fill in. Never commit .env.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://shop.example.com

# Secret admin portal. The admin lives at /<ADMIN_URL>/ and /admin/ returns 404.
# Required when DEBUG=0. Use something long and unguessable, e.g. studio-8f3kq29xz
ADMIN_URL=change-me-secret-path
# Only for `python manage.py ensure_admin` (creates/updates the admin account). Remove after use.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Leave unset for SQLite. Postgres (see docker-compose.yml for a local one):
# DATABASE_URL=postgres://lot:lot@127.0.0.1:5432/lot

# Behind a proxy/load balancer you control (Render, Fly, nginx), so rate limits see real client IPs.
# TRUST_X_FORWARDED_FOR=1

# Blog uploads
# BLOG_MAX_UPLOAD_MB=15
# Optional object storage for uploads (needs `pip install "django-storages[s3]"`):
# S3_BUCKET=
# S3_ENDPOINT_URL=          # e.g. https://<account>.r2.cloudflarestorage.com for Cloudflare R2
# S3_REGION=
# S3_CUSTOM_DOMAIN=         # e.g. media.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email (comment notifications). Defaults to printing emails in the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=hello@example.com

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:8000/stripe/webhook/` or the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Storefront
BRAND_NAME=!perfect
BRAND_EMAIL=hello@notperfect.example
# Footer social icons (full URLs). Leave blank to hide an icon.
# SOCIAL_INSTAGRAM=https://instagram.com/yourname
# SOCIAL_FACEBOOK=https://facebook.com/yourname
# SOCIAL_X=https://x.com/yourname
STORE_CURRENCY=usd
CURRENCY_SYMBOL=$
